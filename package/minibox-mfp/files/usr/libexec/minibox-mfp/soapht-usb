#!/bin/sh
# MiniBox M1522 SOAPHT transport gate.
# This is intentionally fail-closed until the native libusb HorseThief
# transport is installed. Never substitute generic scanimage here.
set -eu

VID="${MINIBOX_SCAN_VID:-03f0}"
PID="${MINIBOX_SCAN_PID:-4517}"
NATIVE="${MINIBOX_SOAPHT_NATIVE:-/usr/libexec/minibox-mfp/soapht-usb-native}"

[ "$VID" = "03f0" ] && [ "$PID" = "4517" ] || {
    echo "soapht-usb: unsupported USB device $VID:$PID" >&2
    exit 65
}

[ -x "$NATIVE" ] || {
    echo "soapht-usb: native SOAPHT/libusb transport not installed" >&2
    exit 69
}

exec "$NATIVE" "$@"
