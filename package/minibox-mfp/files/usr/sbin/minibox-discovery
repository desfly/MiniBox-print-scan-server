#!/bin/sh
# MiniBox MFP DNS-SD discovery contract for HP LaserJet M1522n.
# One logical MFP identity; separate driverless print and scan services.
# No CUPS and no usblp.

set -eu

HOST="${MINIBOX_HOSTNAME:-minibox-mfp}"
MODEL="${MINIBOX_MODEL:-HP LaserJet M1522n}"
NAME="${MINIBOX_FRIENDLY_NAME:-HP LaserJet M1522n (MiniBox)}"
RAW_PORT="${MINIBOX_PRINT_PORT:-9100}"
IPP_PORT="${MINIBOX_IPP_PORT:-631}"
ESCL_PORT="${MINIBOX_ESCL_PORT:-8080}"
PIDDIR=/var/run/minibox-discovery

mkdir -p "$PIDDIR"

cleanup() {
    for f in "$PIDDIR"/*.pid; do
        [ -f "$f" ] || continue
        kill "$(cat "$f")" 2>/dev/null || true
    done
    rm -rf "$PIDDIR"
}
trap cleanup EXIT INT TERM

publish() {
    name="$1"; type="$2"; port="$3"; shift 3
    avahi-publish-service "$name" "$type" "$port" "$@" &
    echo $! > "$PIDDIR/$(echo "$type" | tr -cd '[:alnum:]').pid"
}

command -v avahi-publish-service >/dev/null 2>&1 || {
    echo "minibox-discovery: avahi-publish-service missing" >&2
    exit 1
}

# Driverless printer discovery for Windows 10/11 and Android print services.
# The IPP endpoint itself is implemented separately; advertising it here locks
# the network contract and friendly device identity.
publish "$NAME" _ipp._tcp "$IPP_PORT" \
    "txtvers=1" "qtotal=1" "rp=ipp/print" "ty=$MODEL" \
    "product=($MODEL)" "note=MiniBox USB MFP bridge" \
    "pdl=application/pdf,image/jpeg,image/pwg-raster" \
    "Color=F" "Duplex=F" "usb_MFG=HP" "usb_MDL=LaserJet M1522n"

# Keep the validated raw print path available as compatibility fallback.
publish "$NAME" _pdl-datastream._tcp "$RAW_PORT" \
    "txtvers=1" "qtotal=1" "ty=$MODEL" "product=($MODEL)" \
    "note=MiniBox raw print fallback" "pdl=application/octet-stream"

# AirScan/eSCL discovery for compatible Windows/Android scan clients.
# Scanner protocol stays disabled behind the backend until the physical
# M1522 USB scanner interface and handshake are verified.
publish "$NAME" _uscan._tcp "$ESCL_PORT" \
    "txtvers=1" "ty=$MODEL" "rs=eSCL" "representation=images/printer.png" \
    "note=MiniBox eSCL scanner" "usb_MFG=HP" "usb_MDL=LaserJet M1522n"

# Web UI is the Android/browser scan fallback and local management surface.
publish "$NAME" _http._tcp 80 \
    "path=/" "model=$MODEL" "usb_vid=03f0" "usb_pid=4517" \
    "mfp=printer,scanner"

wait
